# ==========================================================
# lit-review-agent 配置示例
# 复制为 .env 后按需修改：cp .env.example .env
# ==========================================================

# ---------- 1. LLM 接入 ----------
# 可选值: deepseek | openai | ollama | stub
#   deepseek : DeepSeek 官方 API（OpenAI 兼容协议，默认）
#   openai   : OpenAI 官方
#   ollama   : 本地 Ollama（OpenAI 兼容端点）
#   stub     : 离线桩模型，不发任何网络请求，用于跑通流程/单测
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI（LLM_PROVIDER=openai 时生效）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama（LLM_PROVIDER=ollama 时生效）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=2
LLM_TIMEOUT=120
LLM_MAX_WORKERS=4              # LLM 调用并发线程数（P3-4）：Extractor/SectionWriter/GroundClaims 并行

# ---------- 2. 学术 API 礼貌策略 ----------
# 必填：学术 API 靠 mailto / User-Agent 识别善意机器人，会给更高配额
CONTACT_EMAIL=you@example.com

# 可选：Semantic Scholar API key（留空则走无 key 限流通道 100 次/5min）
SEMANTIC_SCHOLAR_API_KEY=

# 启用的检索源，逗号分隔: arxiv,openalex,semantic_scholar
ENABLED_SOURCES=arxiv,openalex

# ---------- 3. 检索与流程参数 ----------
MAX_RESULTS_PER_QUERY=25      # 单条检索式 × 单个源的最大返回条数
TARGET_PAPER_COUNT=40         # 文献池目标规模，不足会触发内环重检索
MAX_RETRIEVAL_ROUNDS=3        # 内环：检索总轮数上限（文献量不足时放大重检索）
MAX_CRITIC_ROUNDS=2           # 外环：Critic 允许「打回补文献」的次数上限
TOP_N_FULLTEXT=8              # 仅对 Top-N 文献下载 PDF 解析全文，其余用摘要
N_CLUSTERS=0                  # 主题簇数，0 = 按文献量自动推断
MIN_YEAR=0                    # 只保留该年份及之后的文献，0 = 不限制

# ---------- 3b. 相关性闸门与排序（P0-1）----------
# 相关性分数低于该阈值的论文会被剔除出候选池，防止「高被引但跑题」文献混入。
# TF-IDF 余弦相似度经验阈值约 0.10；若启用 embedding 相关性可酌情提高到 ~0.25。
RELEVANCE_GATE=0.10
MIN_POOL_AFTER_GATE=20        # 闸门保底：至少保留这么多篇，避免文献池塌缩
# 排序权重（四项之和应为 1.0）
RELEVANCE_WEIGHT=0.55         # 相关性主导
CITATION_WEIGHT=0.20          # 引用数退居次要，不再绑架排序
RECENCY_WEIGHT=0.15
COVERAGE_WEIGHT=0.10

# ---------- 4. 输出 ----------
OUTPUT_DIR=output
CACHE_DIR=.cache
REPORT_LANGUAGE=zh            # zh | en，综述正文语言（术语保留英文）
ENABLE_FULLTEXT=true          # false = 纯摘要模式，完全不下载 PDF

# ---------- 5. 可观测 / 持久化（可选）----------
CHECKPOINT_BACKEND=memory     # memory | sqlite
CHECKPOINT_PATH=.cache/checkpoints.sqlite

# 跨主题持久化文献池（P3-1）：历史文献可召回/回填/复用，省检索配额
PAPER_STORE_ENABLED=true
# PAPER_STORE_PATH=            # 留空则落到 CACHE_DIR/papers.sqlite

# 检索 HTTP 磁盘缓存（P3-4）：命中则跳过网络，省学术 API 配额
HTTP_CACHE_ENABLED=true
HTTP_CACHE_TTL_DAYS=7          # 缓存有效期（天），过期自动回源

# LangSmith 轨迹追踪
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=lit-review-agent
